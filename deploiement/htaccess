# Configuration Apache pour le site Handball (hebergement IONOS mutualise).
# A renommer ".htaccess" a la racine du site.

# --------------------------------------------------------------- types MIME
# Sans cette ligne, beaucoup de clients de calendrier recoivent le .ics en
# text/plain et refusent de s'y abonner ("le fichier n'est pas un calendrier").
AddType text/calendar .ics
AddType application/json .json
AddType text/csv .csv
AddDefaultCharset UTF-8
DirectoryIndex index.html

# ------------------------------------------------------------------- cache
<IfModule mod_headers.c>
  # Les donnees sont regenerees toutes les 3 h : aucun cache intermediaire,
  # sinon Outlook peut relire une version vieille de plusieurs jours.
  <FilesMatch "\.(html|json|ics|csv)$">
    Header set Cache-Control "no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
  # Les logos portent l'empreinte du fichier FFHB : leur contenu ne change jamais.
  <FilesMatch "\.webp$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------- compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/csv text/calendar application/json
</IfModule>

# ------------------------------------------------------------ durcissement
# Pas de liste des fichiers du dossier.
Options -Indexes

# Le code et l'etat de suivi ne doivent jamais etre servis. Ils sont normalement
# stockes hors de la racine web, mais on ne compte pas la-dessus.
<FilesMatch "\.(py|pyc|sh|log)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.(suivi_handball_etat|git|env)">
  Require all denied
</FilesMatch>

